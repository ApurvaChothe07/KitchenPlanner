# KitchenCraft Environment Variables Example
# Copy this file to .env for local Docker and Backend execution

# Database Configuration (PostgreSQL 16)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=kitchencraft_db
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Server & Security Configuration
PORT=8080
BACKEND_PORT=8080
FRONTEND_PORT=80
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# CORS Configuration (Comma-separated allowed origins)
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://localhost:5173,http://localhost:3000

# Logging Level (INFO, DEBUG, WARN, ERROR)
LOG_LEVEL=INFO
