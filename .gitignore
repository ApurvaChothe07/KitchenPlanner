# Root .gitignore for KitchenCraft (Backend + Frontend)

# =========================
# Operating System Files
# =========================
Thumbs.db
Desktop.ini
.DS_Store
*.swp
*~

# =========================
# IDEs and Editors
# =========================
.idea/
*.iml
.vscode/
*.classpath
*.project
*.settings/
*.sublime-project
*.sublime-workspace

# =========================
# Java / Maven
# =========================
backend/target/
target/
*.class
*.jar
*.war
*.ear
*.nar
*.zip
*.tar.gz
*.rar
hs_err_pid*
replay_pid*

# =========================
# Node / Frontend
# =========================
frontend/node_modules/
node_modules/
frontend/dist/
dist/
frontend/dist-ssr/
dist-ssr/
*.local
.npm
.eslintcache
.stylelintcache

# =========================
# Environment Variables & Secrets
# =========================
.env
.env.local
.env.*.local
*.p12
*.pem
*.key

# =========================
# Logs
# =========================
*.log
backend/logs/
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# =========================
# Docker
# =========================
.docker/
docker-compose.override.yml
