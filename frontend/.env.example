# KitchenCraft Frontend Environment Variables
# Copy to frontend/.env for local standalone execution or custom deployments

# Configurable backend API base URL
# Leave as /api/v1 when using Vite dev proxy or Nginx reverse proxy
# Change to http://localhost:8080/api/v1 if running frontend on a separate host/port without proxy
VITE_API_BASE_URL=/api/v1
